QUICK_SCALP_SL_ROI = 0.10  # tight -- exit fast on momentum drop/flip, not "survive a dip" like /fut_
QUICK_SCALP_TP_ROI = 0.30  # small, but several x the fee cost at 30-50x -- a real profit, not just covering cost
LIQUIDATION_SAFETY_FRACTION = 0.8

